# Copy to api/.env.dev (gitignored) and fill in. Read by scripts/dev.sh.
# Leave the Supabase lines empty to keep local data only in api/data.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Never the production table: two api processes on one table overwrite each other.
SUPABASE_TABLE=opengym_files_dev
# Your user id from api/data/db.json → users[].id, to open the admin dashboard (AI coach setup).
ADMIN_UIDS=
